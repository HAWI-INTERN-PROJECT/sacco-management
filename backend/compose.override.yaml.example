networks:
  laravel:

services:
  app:
    build:
      context: ./dockerfiles
      dockerfile: nginx.dockerfile
      args:
        - UID=${UID:-1000}
        - GID=${GID:-1000}
    ports:
      - "80:80"
    volumes:
      - .:/var/www/html:delegated
    depends_on:
      - php
      - redis
      - postgres
      - mysql
      - mailpit
      - meilisearch
    networks:
      - laravel

  postgres:
    image: postgres:alpine
    tty: true
    ports:
      - "5432:5432"
    environment:
      POSTGRES_DB: ${DB_DATABASE:-homestead}
      POSTGRES_USER: ${DB_USER:-homestead}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-secret}
    volumes:
      - ./volumes/postgres:/var/lib/postgresql
    networks:
      - laravel

  mysql:
    image: mysql
    tty: true
    ports:
      - "3306:3306"
    environment:
      MYSQL_DATABASE: ${DB_DATABASE:-homestead}
      MYSQL_USER: ${DB_USER:-homestead}
      MYSQL_PASSWORD: ${DB_PASSWORD:-secret}
      MYSQL_ROOT_PASSWORD: ${DB_PASSWORD:-secret}
    volumes:
      - ./volumes/mysql:/var/lib/mysql
    networks:
      - laravel

  php:
    build:
      context: ./dockerfiles
      dockerfile: php.dockerfile
      args:
        - UID=${UID:-1000}
        - GID=${GID:-1000}
    image: laravel-api-kit:php
    ports:
      - "9000:9000"
    volumes:
      - .:/var/www/html:delegated
    networks:
      - laravel

  redis:
    image: redis:alpine
    ports:
      - "6379:6379"
    networks:
      - laravel

  composer:
    image: inventory:php
    volumes:
      - .:/var/www/html
    depends_on:
      - php
    entrypoint: [ 'composer' ]
    networks:
      - laravel

  artisan:
    image: laravel-api-kit:php
    volumes:
      - .:/var/www/html:delegated
    depends_on:
      - postgres
    entrypoint: [ 'php', '/var/www/html/artisan' ]
    networks:
      - laravel

  mailpit:
    image: axllent/mailpit
    ports:
      - "1025:1025"
      - "8025:8025"
    networks:
      - laravel

  meilisearch:
    image: getmeili/meilisearch:latest
    ports:
      - "7700:7700"
    environment:
      - MEILISEARCH_MASTER_KEY=${MEILISEARCH_KEY:-masterKey}
    networks:
      - laravel

  adminer:
    image: adminer:latest
    ports:
      - "8080:8080"
    networks:
      - laravel

  npm:
    image: node:current-alpine
    volumes:
      - .:/var/www/html
    ports:
      - "3000:3000"
      - "3001:3001"
      - "5173:5173"
    working_dir: /var/www/html
    entrypoint: [ 'npm' ]
    networks:
      - laravel
